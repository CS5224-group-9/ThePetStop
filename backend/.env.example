DJANGO_SECRET_KEY=generate-one-see-readme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://petstop:petstop@localhost:5432/petstop
# Cognito user pool for bearer tokens; leave blank to use only the admin session login.
# Issuer: https://cognito-idp.ap-southeast-1.amazonaws.com/<user pool id>
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Optional: OneMap account credentials for public address/postal-code search.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Optional existing token; used first. Email/password allow automatic renewal.
ONEMAP_ACCESS_TOKEN=

# Facility ingestion Lambda settings for local Floci runs.
# These are passed explicitly to the Lambda functions; Django does not forward them.
FACILITY_SYNC_BUCKET=petstop-facility-sync-local
GEOCODE_QUEUE_URL=http://floci:4566/000000000000/petstop-geocode-local.fifo
GEOCODE_BATCH_MAX_REQUESTS=10
ONEMAP_REQUESTS_PER_MINUTE=75
# Production geocoder: Secrets Manager JSON with email/password (optional access_token).
ONEMAP_SECRET_ARN=
GEOCODE_CACHE_MAX_AGE_DAYS=90
# More than this fraction deactivated requires approval of the exact snapshot digest.
FACILITY_MAX_DEACTIVATION_FRACTION=0.2
FACILITY_MAX_RUN_AGE_HOURS=24
# Local fixtures only; production never sets this URL.
ONEMAP_FIXTURE_URL=http://fixtures:8080
# For fixture mode only, set true and configure FACILITY_SOURCE_CONFIG with fixture URLs.
FACILITY_FIXTURE_MODE=false
FACILITY_SOURCE_CONFIG={}
