DJANGO_SECRET_KEY=generate-one-see-readme
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgres://petstop:petstop@localhost:5432/petstop
# Cognito user pool for bearer tokens; leave blank to use only the admin session login.
# Issuer: https://cognito-idp.ap-southeast-1.amazonaws.com/<user pool id>
COGNITO_ISSUER=
COGNITO_CLIENT_ID=

# Optional: OneMap account credentials for public address/postal-code search.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=

# Optional existing token; used first. Email/password allow automatic renewal.
ONEMAP_ACCESS_TOKEN=

# If PETSTOP_DB_PORT is not 5432, use that port in DATABASE_URL.

# Local development only: accept "Authorization: Dev <alice|bob|mira>" instead of
# Cognito tokens, from this computer only. Needs DJANGO_DEBUG=True. Never set it in
# AWS (Django refuses to start).
DJANGO_DEV_AUTH=false

# Private pet files (photos, vet reports). Leave PET_FILES_BUCKET blank locally:
# with DJANGO_DEBUG=True, files are stored under backend/.local-storage/ through
# signed URLs on this server. In AWS the stack sets PET_FILES_BUCKET.
# PET_FILES_ENDPOINT_URL is only for an S3-compatible emulator.
PET_FILES_BUCKET=
PET_FILES_REGION=ap-southeast-1
PET_FILES_ENDPOINT_URL=
PET_FILES_LOCAL_DIR=
# Must use the same host and port as runserver and NEXT_PUBLIC_API_BASE_URL.
PET_FILES_LOCAL_URL=http://localhost:8000/api/v1/local-files/
