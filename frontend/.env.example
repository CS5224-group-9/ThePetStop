# local (default): standalone UI with sample data; api: enable backend/Cognito integration
NEXT_PUBLIC_DATA_SOURCE=local
# Public build-time frontend configuration. Never put secrets in NEXT_PUBLIC_*.
# The API base includes /api/v1/. Also enables live location search in local mode.
# Local example: http://localhost:8000/api/v1/
NEXT_PUBLIC_API_BASE_URL=
# A Cognito app client for this SPA must have NO client secret.
# Example domain: https://your-domain.auth.ap-southeast-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_DOMAIN=
# Example issuer: https://cognito-idp.ap-southeast-1.amazonaws.com/ap-southeast-1_POOL
NEXT_PUBLIC_COGNITO_ISSUER=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
# Register these EXACT addresses in Cognito. Keep trailing slashes.
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback/
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000/
# Include any resource-server scope required by your API Gateway authorizer.
NEXT_PUBLIC_COGNITO_SCOPES=openid email profile
